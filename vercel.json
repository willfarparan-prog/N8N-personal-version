{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/session.py", "use": "@vercel/python" },
    { "src": "api/auth/login.py", "use": "@vercel/python" },
    { "src": "api/auth/logout.py", "use": "@vercel/python" },
    { "src": "api/workflows/index.py", "use": "@vercel/python" },
    { "src": "api/workflows/[id].py", "use": "@vercel/python" },
    { "src": "api/workflows/[id]/run.py", "use": "@vercel/python" },
    { "src": "api/webhook/[id].py", "use": "@vercel/python" },
    { "src": "api/executions/[id].py", "use": "@vercel/python" },
    { "src": "api/integrations/google.py", "use": "@vercel/python" },
    { "src": "api/v2.py", "use": "@vercel/python" },
    { "src": "api/cron/poll_schedules.py", "use": "@vercel/python" },
    { "src": "api/cron/poll_jobs.py", "use": "@vercel/python" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/session", "dest": "/api/session.py" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.py" },
    { "src": "/api/auth/logout", "dest": "/api/auth/logout.py" },
    { "src": "/api/workflows/([^/]+)/run", "dest": "/api/workflows/[id]/run.py?id=$1" },
    { "src": "/api/workflows/([^/]+)", "dest": "/api/workflows/[id].py?id=$1" },
    { "src": "/api/workflows", "dest": "/api/workflows/index.py" },
    { "src": "/api/webhook/([^/]+)", "dest": "/api/webhook/[id].py?id=$1" },
    { "src": "/api/executions/([^/]+)", "dest": "/api/executions/[id].py?id=$1" },
    { "src": "/api/integrations/google/authorize", "dest": "/api/integrations/google.py?action=authorize" },
    { "src": "/api/integrations/google/callback", "dest": "/api/integrations/google.py?action=callback" },
    { "src": "/api/integrations/google", "dest": "/api/integrations/google.py" },
    { "src": "/api/providers/([^/]+)/models", "dest": "/api/v2.py?handler=providers&provider=$1" },
    { "src": "/api/workflows/([^/]+)/publications", "dest": "/api/v2.py?handler=publications&id=$1&action=create" },
    { "src": "/api/publications/([^/]+)/rotate", "dest": "/api/v2.py?handler=publications&id=$1&action=rotate" },
    { "src": "/api/publications/([^/]+)", "dest": "/api/v2.py?handler=publications&id=$1" },
    { "src": "/api/public/([^/]+)/(config|run)", "dest": "/api/v2.py?handler=publications&token=$1&action=$2" },
    { "src": "/api/public/([^/]+)/executions/([^/]+)", "dest": "/api/v2.py?handler=publications&token=$1&execution_id=$2&action=execution" },
    { "src": "/api/uploads/sign", "dest": "/api/v2.py?handler=uploads" },
    { "src": "/api/workflows/([^/]+)/batches", "dest": "/api/v2.py?handler=batches&id=$1&action=create" },
    { "src": "/api/batches/([^/]+)/(cancel|retry)", "dest": "/api/v2.py?handler=batches&id=$1&action=$2" },
    { "src": "/api/batches/([^/]+)/results.csv", "dest": "/api/v2.py?handler=batches&id=$1&action=csv" },
    { "src": "/api/batches/([^/]+)", "dest": "/api/v2.py?handler=batches&id=$1" },
    { "src": "/api/provider-events/(openrouter|fal)", "dest": "/api/v2.py?handler=provider_events&provider=$1" },
    { "src": "/api/brand-kits", "dest": "/api/v2.py?handler=brand_kits" },
    { "src": "/api/brand-kits/([^/]+)/(assets|analyze|versions|profile)", "dest": "/api/v2.py?handler=brand_kits&id=$1&action=$2" },
    { "src": "/api/models/([^/]+)", "dest": "/api/v2.py?handler=models&id=$1" },
    { "src": "/api/models", "dest": "/api/v2.py?handler=models" },
    { "src": "/p/([^/]+)", "dest": "/public/p.html" },
    { "src": "/embed/([^/]+)", "dest": "/api/v2.py?handler=embed&token=$1" },
    { "src": "/api/assets/([^/]+)", "dest": "/api/v2.py?handler=assets&id=$1" },
    { "src": "/api/cron/poll_schedules", "dest": "/api/cron/poll_schedules.py" },
    { "src": "/api/cron/poll_jobs", "dest": "/api/cron/poll_jobs.py" },
    { "src": "/api/cron/cleanup_assets", "dest": "/api/v2.py?handler=cleanup_assets" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/integrations.html", "dest": "/public/integrations.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
